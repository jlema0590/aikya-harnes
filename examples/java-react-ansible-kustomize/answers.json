{
  "mode": "new",
  "name": "servicios-java-react-ansible-kustomize",
  "backend": "java",
  "backend_framework": "spring-boot",
  "frontend": "react",
  "mobile": "none",
  "architecture": "clean",
  "architecture_patterns": [
    "event-driven"
  ],
  "database": "postgresql",
  "ci": "github-actions",
