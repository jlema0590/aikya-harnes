      "compose": true
    },
    "orchestration": "kubernetes",
    "deployment_method": "kustomize",
    "environments": [
      "dev",
      "staging",
      "prod"
    ],
    "image_repository": "registry.example.test/backend:1.0.0",
    "container_port": 8080
  }
